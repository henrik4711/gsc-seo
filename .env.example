# ─────────────────────────────────────────────────────────────────────
# Local development .env for the NiceGUI SEO app (test locally, then set the
# same values as Railway env vars). Copy to `.env` and fill in. `.env` and
# *.json are gitignored — secrets never get committed.
#
#   cp .env.example .env    # then edit
#   pip install -r nicegui_app/requirements.txt
#   python -m nicegui_app.main    # http://localhost:8080
#
# These values are PER SITE. This template is filled for mshop.dk.
# ─────────────────────────────────────────────────────────────────────

# ── Required to start ──
APP_PASSWORD=dev                       # login password for the app (fail-closed if unset)
NICEGUI_STORAGE_SECRET=change-me       # signs the auth/session cookie
DATA_DIR=./data                        # local persistence folder (Railway uses /data)
PORT=8080

# ── Claude (AI steps: clustering, cluster health, content quality, planning) ──
ANTHROPIC_API_KEY=sk-ant-...

# ── Google Search Console (Fetch GSC data) ──
# Option A: paste the full service-account JSON on ONE line:
# GSC_CREDENTIALS_JSON={"type":"service_account","project_id":"...", ...}
# Option B (cleaner locally): point to the JSON file (gitignored):
GSC_CREDENTIALS_FILE=./gsc-service-account.json
GSC_SITE_URL=sc-domain:mshop.dk        # exact GSC property (or https://www.mshop.dk/)

# ── Site context for the AI + content language ──
SITE_CONTEXT=Dansk webshop for sexlegetoej og intimprodukter. Tone: hjaelpsom, diskret, ekspert.
CONTENT_LANGUAGE=Danish

# ── Mshop Admin API (Audit pages URL source: active categories/CMS/filterpages) ──
SITE_CODE=mshop_dk
MSHOP_ADMIN_API_BASE=https://...       # or FOOTER_TEXT_API below
FOOTER_TEXT_API=https://...
FOOTER_TEXT_STORE_ID=...
FOOTER_TEXT_API_USER=...
FOOTER_TEXT_API_PASS=...

# ── Unrelated to this app (kept from before) ──
# WP_PUBLISHER_API_KEY=change-me-to-a-random-secret
